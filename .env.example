# OANDA Practice Account
OANDA_API_TOKEN=your_oanda_api_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_API_URL=https://api-fxpractice.oanda.com

# Binance (optional — public endpoints work without keys)
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_BASE_URL=https://api.binance.us

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_EMAIL_TO=recipient@email.com

# Execution Mode
# Options: ALERT_ONLY | SEMI_AUTO | FULL_AUTO
EXECUTION_MODE=ALERT_ONLY

# Token Budgets
DAILY_TOKEN_BUDGET_USD=2.0
MONTHLY_TOKEN_BUDGET_USD=20.0

# Agent Thresholds — confidence 7+ only (Weekly + Daily aligned)
ANALYST_MIN_CONFIDENCE=7

# Risk Management — works for both $1K real and $100K paper accounts
# Position size scales dynamically: balance × risk_pct ÷ stop_distance
MAX_RISK_PER_TRADE=0.02
DAILY_LOSS_LIMIT=0.03
MAX_OPEN_POSITIONS=2
MIN_RISK_REWARD_RATIO=2.5
NEWS_BLACKOUT_MINUTES=30

# Validator mode: required | optional | off
# required = no Claude validation, no trade (safest)
# optional = trade mechanically if validator unavailable
# off      = pure mechanical engine, zero AI in the trade path
VALIDATOR_MODE=required

# Dead-man's switch (optional): healthchecks.io ping URL. The watchdog pings
# it every 5 min while healthy; missed pings trigger a push notification.
HEALTHCHECK_PING_URL=
